{
  "providers": {
    "priority": ["azure_openai", "openai", "google", "aws_bedrock", "ollama"],
    "openai": {
      "model": "gpt-4o"
    },
    "azure_openai": {
      "deployment": "gpt-4o",
      "api_version": "2024-02-15-preview"
    },
    "google": {
      "model": "gemini-1.5-pro"
    },
    "aws_bedrock": {
      "model": "anthropic.claude-3-5-sonnet-20241022-v2:0",
      "region": "us-east-1"
    },
    "ollama": {
      "base_url": "http://localhost:11434",
      "model": "llama3.2"
    }
  },
  "agents": {
    "orchestrator": {
      "provider": "auto",
      "model": "auto"
    },
    "subagents": {
      "provider": "auto",
      "model": "auto",
      "max_concurrent": 8
    }
  },
  "context": {
    "max_tokens": 180000,
    "recent_messages_always_include": 20,
    "compact_threshold": 0.85
  },
  "workspace": {
    "path": "storage/workspace",
    "allowed_extensions": [
      ".md", ".txt", ".py", ".js", ".ts", ".json",
      ".yaml", ".yml", ".toml", ".sh", ".html", ".css",
      ".sql", ".env.example", ".gitignore"
    ]
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": false
  }
}
